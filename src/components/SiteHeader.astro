---
import {
  getContactRows,
  getHeaderCta,
  getLinkAttributes,
  getPrimaryNavItems,
  isContactNavItem,
  isNavItemActive,
  type HeaderCtaVariant,
  type SiteSettings,
} from '../lib/site/chrome';

type Props = {
  settings: SiteSettings;
  currentPath: string;
  ctaVariant?: HeaderCtaVariant;
};

const { settings, currentPath, ctaVariant = 'consult' } = Astro.props;
const navItems = getPrimaryNavItems(settings);
const contactRows = getContactRows(settings);
const cta = getHeaderCta(settings, ctaVariant);
const ctaAttributes = getLinkAttributes(cta.href, cta.external);
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand-mark" href="/" aria-label={`${settings.brandName} 首頁`}>
      <img class="brand-logo" src={settings.logo} alt={`${settings.brandName} ${settings.brandNameEn}`} width="180" height="40" />
    </a>

    <button class="nav-toggle" id="nav-toggle" type="button" aria-label="開啟選單" aria-expanded="false" aria-controls="primary-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="主選單">
      {navItems.map((item) => (
        isContactNavItem(item) ? (
          <div class="nav-dd">
            <button class="nav-dd-trigger" type="button" aria-expanded="false" aria-controls="contact-menu">
              {item.label}
              <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>
            <div class="nav-dd-menu" id="contact-menu">
              {contactRows.map((row) => (
                row.href ? (
                  <a {...getLinkAttributes(row.href, row.external)}>
                    <span class="ico">{row.key}</span>
                    {row.label}
                  </a>
                ) : (
                  <span class="nav-dd-text">
                    <span class="ico">{row.key}</span>
                    {row.label}
                  </span>
                )
              ))}
            </div>
          </div>
        ) : (
          <a
            {...getLinkAttributes(item.href, item.external ?? undefined)}
            class:list={[{ 'is-active': isNavItemActive(item, currentPath) }]}
            aria-current={isNavItemActive(item, currentPath) ? 'page' : undefined}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <span class="header-spacer"></span>
    <a class="header-cta" {...ctaAttributes}>
      {cta.label}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</header>

<script is:inline>
(() => {
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.classList.toggle('is-active', open);
      toggle.setAttribute('aria-expanded', String(open));
    });

    nav.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.classList.remove('is-active');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  document.querySelectorAll('.nav-dd-trigger').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      const dropdown = button.closest('.nav-dd');
      if (!dropdown) return;
      const open = dropdown.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(open));
    });
  });

  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('.nav-dd')) return;
    document.querySelectorAll('.nav-dd.is-open').forEach((dropdown) => {
      dropdown.classList.remove('is-open');
      dropdown.querySelector('.nav-dd-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });
})();
</script>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--color-white);
  border-bottom: 1px solid var(--color-muted-border);
}

.site-header::before {
  content: "";
  display: block;
  height: 4px;
  background: var(--color-brand);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: 32px;
  height: 84px;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.brand-logo {
  width: auto;
  height: 40px;
}

.primary-nav {
  display: flex;
  gap: 36px;
  margin-left: 24px;
}

.primary-nav a,
.nav-dd-trigger {
  color: var(--color-text);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.primary-nav a {
  padding: 8px 0;
  border-bottom: 2px solid transparent;
  transition: color .25s ease, border-color .25s ease;
}

.primary-nav a:hover,
.primary-nav a.is-active,
.nav-dd:hover .nav-dd-trigger,
.nav-dd.is-open .nav-dd-trigger {
  color: var(--color-heading);
  border-bottom-color: var(--color-brand);
}

.header-spacer {
  flex: 1;
}

.header-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 40px;
  padding: 10px 22px;
  background: var(--color-brand);
  color: var(--color-white);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: background .25s ease;
}

.header-cta:hover {
  background: var(--color-brand-strong);
}

.nav-dd {
  position: relative;
  display: flex;
  align-items: center;
}

.nav-dd-trigger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 0;
  background: none;
  border: 0;
  border-bottom: 2px solid transparent;
  transition: color .25s ease, border-color .25s ease;
}

.chev {
  transition: transform .25s ease;
}

.nav-dd:hover .chev,
.nav-dd.is-open .chev {
  transform: rotate(180deg);
}

.nav-dd-menu {
  position: absolute;
  top: 100%;
  right: 0;
  z-index: 60;
  display: flex;
  min-width: 264px;
  flex-direction: column;
  padding: 8px;
  background: var(--color-white);
  border: 1px solid var(--color-muted-border);
  border-top: 2px solid var(--color-brand);
  box-shadow: 0 18px 40px -16px rgba(40, 36, 34, .28);
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: opacity .2s ease, transform .2s ease, visibility .2s;
}

.nav-dd:hover .nav-dd-menu,
.nav-dd.is-open .nav-dd-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.nav-dd-menu a,
.nav-dd-text {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 12px;
  color: var(--color-text);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: none;
  border-radius: var(--radius-xs);
}

.nav-dd-menu a {
  transition: background .2s ease, color .2s ease;
}

.nav-dd-menu a:hover {
  background: var(--color-page);
  color: var(--color-heading);
}

.nav-dd-text {
  cursor: default;
}

.ico {
  min-width: 40px;
  flex-shrink: 0;
  padding: 4px 6px;
  color: var(--color-brand-strong);
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-align: center;
  border: 1px solid var(--color-muted-border);
  border-radius: var(--radius-xs);
}

.nav-toggle {
  display: none;
  width: 44px;
  height: 44px;
  margin-left: auto;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  background: none;
  border: 0;
}

.nav-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--color-heading);
  transition: transform .25s ease, opacity .2s ease;
}

.nav-toggle.is-active span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.nav-toggle.is-active span:nth-child(2) {
  opacity: 0;
}

.nav-toggle.is-active span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

@media (max-width: 980px) {
  .header-inner {
    position: relative;
    gap: 16px;
    height: 72px;
  }

  .brand-logo {
    height: 36px;
  }

  .nav-toggle {
    display: flex;
  }

  .header-spacer,
  .header-cta {
    display: none;
  }

  .primary-nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    max-height: 0;
    margin: 0;
    padding: 6px 24px 18px;
    overflow: hidden;
    background: var(--color-white);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-muted-border);
    box-shadow: 0 18px 40px -16px rgba(40, 36, 34, .18);
    opacity: 0;
    visibility: hidden;
    transition: max-height .3s ease, opacity .25s ease, visibility .3s;
  }

  .primary-nav.is-open {
    max-height: 85vh;
    overflow: auto;
    opacity: 1;
    visibility: visible;
  }

  .primary-nav > a {
    padding: 15px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .nav-dd {
    flex-direction: column;
    align-items: stretch;
  }

  .nav-dd-trigger {
    width: 100%;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .nav-dd-menu {
    position: static;
    min-width: 0;
    max-height: 0;
    padding: 4px 0 10px;
    overflow: hidden;
    border: 0;
    border-bottom: 1px solid var(--color-hairline);
    box-shadow: none;
    opacity: 1;
    visibility: hidden;
    transform: none;
    transition: max-height .25s ease, visibility .25s;
  }

  .nav-dd.is-open .nav-dd-menu {
    max-height: 360px;
    visibility: visible;
  }
}
</style>
