---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top">
      <span class="mark">
        <svg viewBox="0 0 28 28" fill="none">
          <circle cx="14" cy="14" r="13" fill="oklch(0.590 0.135 45)"/>
          <path d="M7 19 L14 9 L21 19" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <circle cx="14" cy="14" r="1.6" fill="white"/>
        </svg>
      </span>
      奕德不動產
      <small>YI&middot;DE</small>
    </a>
    <nav class="primary">
      <a href="#properties">可入住物件</a>
      <a href="#about">關於我們</a>
      <a href="#faq">常見問題</a>
    </nav>
    <span class="nav-spacer"></span>
    <a class="nav-cta" href="#contact">
      聯絡我們
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>
  </div>
</header>

<style is:global>
/* ---------- brand mark (shared with footer) ---------- */
.brand{
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--serif);
  font-size: 26px;
  letter-spacing: -0.3px;
  color: var(--ink);
  line-height: 1;
}
.brand .mark{
  width: 28px; height: 28px;
  flex-shrink: 0;
  display: inline-block;
  position: relative;
}
.brand .mark svg{ display:block; width:100%; height:100%; }
.brand small{
  font-family: var(--mono);
  font-size: 10.5px;
  color: var(--muted);
  letter-spacing: 1.2px;
  margin-left: 4px;
  align-self: flex-end;
  padding-bottom: 4px;
}

/* ---------- top nav ---------- */
header.nav{
  position: sticky; top: 0; z-index: 50;
  background: color-mix(in oklab, var(--canvas) 92%, transparent);
  backdrop-filter: saturate(140%) blur(10px);
  border-bottom: 1px solid var(--hairline-soft);
}
.nav-inner{
  display: flex; align-items: center; gap: 32px;
  height: 76px;
}
nav.primary{
  display: flex; gap: 28px;
  margin-left: 16px;
}
nav.primary a{
  font-size: 15px; font-weight: 500; color: var(--ink);
  padding: 6px 0;
  border-bottom: 1.5px solid transparent;
  transition: border-color .15s ease, color .15s ease;
}
nav.primary a:hover{ border-bottom-color: var(--ink); }
.nav-spacer{ flex: 1; }
.nav-cta{
  display: inline-flex; align-items: center; gap: 8px;
  height: 44px; padding: 0 22px;
  border-radius: var(--r-pill);
  background: var(--ink); color: var(--canvas);
  font-size: 14px; font-weight: 500;
  border: none;
  transition: background .15s ease;
  text-decoration: none;
}
.nav-cta:hover{ background: var(--accent-deep); }

@media (max-width: 820px){
  nav.primary{ display: none; }
}
</style>
