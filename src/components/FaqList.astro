---
import type { FAQItem } from '../lib/api/brand';

type Props = {
  items: FAQItem[];
};

const { items } = Astro.props;
---
<section class="band" id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="label">— 常見問題</div>
        <h2>關於奕德，<br><em>你可能想知道</em>。</h2>
      </div>
      <p class="right">沒在下方找到答案？歡迎直接來電或寫信給我們，營業時間內快速回覆。</p>
    </div>
    <div class="faq-list" id="faq-list" aria-label="常見問題列表">
      {items.length === 0 ? (
        <p role="status" style="color:var(--muted);text-align:center;padding:48px 0;">目前沒有常見問題。</p>
      ) : (
        items.map((item, index) => (
          <details class="faq" open={index === 0}>
            <summary>
              <span class="q-num">Q.{String(index + 1).padStart(2, '0')}</span>
              <span class="q-text">{item.question}</span>
              <span class="plus">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <div class="a">{item.answer}</div>
          </details>
        ))
      )}
    </div>
  </div>
</section>

<style is:global>
/* ---------- FAQ ---------- */
.faq-list{
  display: flex; flex-direction: column;
  border-top: 1px solid var(--hairline);
}
.faq{ border-bottom: 1px solid var(--hairline); }
.faq summary{
  list-style: none;
  cursor: pointer;
  padding: 26px 8px 26px 0;
  display: flex; align-items: center; gap: 24px;
  font-family: var(--serif);
  font-size: 22px;
  line-height: 1.3;
  color: var(--ink);
  letter-spacing: -.2px;
}
.faq summary::-webkit-details-marker{ display: none; }
.faq summary .q-num{
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  flex-shrink: 0;
  min-width: 28px;
  transform: translateY(-2px);
}
.faq summary .q-text{ flex: 1; }
.faq summary .plus{
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 1px solid var(--hairline);
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: transform .25s ease, background .25s ease, color .25s ease, border-color .25s ease;
  color: var(--ink);
}
.faq[open] summary .plus{
  background: var(--ink); color: var(--canvas); border-color: var(--ink);
  transform: rotate(45deg);
}
.faq .a{
  padding: 0 64px 28px 56px;
  color: var(--body);
  font-size: 15.5px;
  line-height: 1.7;
  max-width: 70ch;
}
@media (max-width: 600px){
  .faq summary{ font-size: 18px; gap: 14px; }
  .faq .a{ padding-left: 42px; padding-right: 0; }
}
</style>
