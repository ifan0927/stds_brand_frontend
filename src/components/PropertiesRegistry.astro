---
---
<section class="band" id="properties">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="label">— 目前可入住</div>
        <h2>正在<em>等你的</em><br>下一個家。</h2>
      </div>
      <p class="right">每一間物件皆由奕德親自驗收、簽約、代管，分布於大台南各行政區。</p>
    </div>

    <div class="props-list" id="props-list">
      <div class="prop-row-skel"></div>
      <div class="prop-row-skel"></div>
      <div class="prop-row-skel"></div>
    </div>
    <div class="props-foot" id="props-foot" style="visibility:hidden">
      <span class="count"></span>
      <div class="pager" id="pager" hidden>
        <button type="button" id="prev-page" aria-label="上一頁">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 5l-7 7 7 7"/></svg>
        </button>
        <span class="pos"><em id="page-now">1</em> / <span id="page-total">1</span></span>
        <button type="button" id="next-page" aria-label="下一頁">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style is:global>
/* ---------- properties (editorial registry) ---------- */
.props-list{
  border-top: 1px solid var(--hairline);
}
.prop-row{
  display: grid;
  grid-template-columns: 56px 1fr 1.1fr 110px 28px;
  align-items: center;
  gap: 24px;
  padding: 22px 12px 22px 4px;
  border-bottom: 1px solid var(--hairline);
  cursor: pointer;
  transition: background .18s ease, padding .18s ease;
}
.prop-row:hover{ background: var(--surface-soft); padding-left: 16px; }
.prop-row .idx{
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 1px;
}
.prop-row .name{
  font-family: var(--serif);
  font-size: 28px;
  line-height: 1.1;
  letter-spacing: -.3px;
  color: var(--ink);
}
.prop-row .addr{
  font-size: 14.5px;
  color: var(--body);
}
.prop-row .addr .district{
  color: var(--muted);
  margin-right: 6px;
}
.prop-chip{
  justify-self: start;
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 12px 6px 10px;
  border-radius: var(--r-pill);
  background: var(--canvas);
  border: 1px solid var(--hairline);
  font-size: 12.5px; font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
}
.prop-chip .pip{
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--leaf);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--leaf) 18%, transparent);
}
.prop-chip.full{ color: var(--muted); background: transparent; }
.prop-chip.full .pip{ background: var(--muted-soft); box-shadow: none; }
.prop-row .arrow{
  width: 28px; height: 28px;
  border-radius: 50%;
  border: 1px solid var(--hairline);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--muted);
  transition: transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
}
.prop-row:hover .arrow{
  background: var(--ink); color: var(--canvas); border-color: var(--ink);
  transform: translateX(2px);
}
.props-foot{
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 24px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 0.6px;
  gap: 16px;
  flex-wrap: wrap;
}
.props-foot .count em{
  font-style: normal;
  color: var(--accent-deep);
  font-weight: 500;
}
.pager{
  display: inline-flex; align-items: center; gap: 6px;
}
.pager button{
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 1px solid var(--hairline);
  background: var(--canvas);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--ink);
  transition: background .15s ease, border-color .15s ease, color .15s ease, opacity .15s ease;
}
.pager button:hover:not(:disabled){ background: var(--ink); color: var(--canvas); border-color: var(--ink); }
.pager button:disabled{ opacity: .35; cursor: not-allowed; }
.pager .pos{
  margin: 0 10px;
  font-family: var(--mono);
  font-size: 12.5px;
  color: var(--ink);
  letter-spacing: 0.6px;
}
.pager .pos em{
  font-style: normal;
  color: var(--accent-deep);
  font-weight: 500;
}
@media (max-width: 820px){
  .prop-row{
    grid-template-columns: 40px 1fr 96px;
    grid-template-areas:
      "idx  name  chip"
      "idx  addr  arrow";
    row-gap: 6px;
    padding: 20px 8px;
  }
  .prop-row .idx{ grid-area: idx; align-self: start; padding-top: 6px; }
  .prop-row .name{ grid-area: name; font-size: 22px; }
  .prop-row .addr{ grid-area: addr; font-size: 13.5px; }
  .prop-chip{ grid-area: chip; justify-self: end; }
  .prop-row .arrow{ grid-area: arrow; justify-self: end; }
}
/* skeleton row */
.prop-row-skel{
  height: 76px;
  border-bottom: 1px solid var(--hairline);
  background: linear-gradient(90deg,
    transparent 0%,
    color-mix(in oklab, var(--surface-soft) 60%, transparent) 50%,
    transparent 100%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
</style>

<script>
const API_BASE = "/mock";
const PAGE_SIZE = 6;
let _propsState = { all: [], page: 1 };

function splitAddress(addr){
  const m = addr.match(/^(.+?[市縣].+?[區鄉鎮市])(.*)$/);
  if (m) return { district: m[1], rest: m[2].trim() };
  return { district: '', rest: addr };
}

function drawPropsPage(){
  const list = document.getElementById('props-list');
  const { all, page } = _propsState;
  const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
  const start = (page - 1) * PAGE_SIZE;
  const slice = all.slice(start, start + PAGE_SIZE);

  list.innerHTML = slice.map((p, i) => {
    const { district, rest } = splitAddress(p.address);
    const globalIdx = start + i + 1;
    return `
      <div class="prop-row" data-id="${p.property_id}">
        <span class="idx">${String(globalIdx).padStart(2,'0')}</span>
        <span class="name">${p.property_public_name}</span>
        <span class="addr"><span class="district">${district}</span>${rest}</span>
        <span class="prop-chip ${p.has_vacant_room ? '' : 'full'}">
          <span class="pip"></span>
          ${p.has_vacant_room ? '可入住' : '滿房'}
        </span>
        <span class="arrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </span>
      </div>
    `;
  }).join('');

  const vacant = all.filter(i => i.has_vacant_room).length;
  const foot = document.getElementById('props-foot');
  const pager = document.getElementById('pager');
  foot.style.visibility = 'visible';
  foot.querySelector('.count').innerHTML =
    `共 <em>${vacant}</em> 間可入住 · 顯示 ${start + 1}–${start + slice.length} / ${all.length} 間`;

  if (totalPages > 1){
    pager.hidden = false;
    document.getElementById('page-now').textContent = String(page);
    document.getElementById('page-total').textContent = String(totalPages);
    document.getElementById('prev-page').disabled = page <= 1;
    document.getElementById('next-page').disabled = page >= totalPages;
  } else {
    pager.hidden = true;
  }
}

function renderProps(items){
  const list = document.getElementById('props-list');
  if (!items || items.length === 0){
    list.innerHTML = `<p style="color:var(--muted);text-align:center;padding:64px 0;border-bottom:1px solid var(--hairline);">目前無可入住物件。</p>`;
    document.getElementById('props-foot').style.visibility = 'hidden';
    return;
  }
  const sorted = [...items].sort((a,b) => (b.has_vacant_room ? 1 : 0) - (a.has_vacant_room ? 1 : 0));
  _propsState = { all: sorted, page: 1 };
  drawPropsPage();
}

document.getElementById('prev-page').addEventListener('click', () => {
  if (_propsState.page > 1){
    _propsState.page -= 1;
    drawPropsPage();
    document.getElementById('properties').scrollIntoView({ behavior: 'instant', block: 'start' });
  }
});
document.getElementById('next-page').addEventListener('click', () => {
  const total = Math.ceil(_propsState.all.length / PAGE_SIZE);
  if (_propsState.page < total){
    _propsState.page += 1;
    drawPropsPage();
    document.getElementById('properties').scrollIntoView({ behavior: 'instant', block: 'start' });
  }
});

(async () => {
  try {
    const r = await fetch(`${API_BASE}/availability.json`);
    const { items } = await r.json();
    renderProps(items);
  } catch(err) {
    console.error('availability fetch failed', err);
  }
})();
</script>
