---
import { sortAvailabilityForDisplay, type PropertyAvailabilityItem } from '../lib/api/brand';

type Intro = {
  eyebrow: string;
  title: string;
  lede: string;
};

type Props = {
  items: PropertyAvailabilityItem[];
  intro: Intro;
};

const PAGE_SIZE = 8;
const { items, intro } = Astro.props;
const sortedItems = sortAvailabilityForDisplay(items);
const totalPages = Math.max(1, Math.ceil(sortedItems.length / PAGE_SIZE));
const vacantCount = sortedItems.filter((item) => item.has_vacant_room).length;

function splitAddress(address: string): { district: string; rest: string } {
  const match = address.match(/^(.+?[市縣].+?[區鄉鎮市])(.*)$/);
  if (match) return { district: match[1], rest: match[2].trim() };
  return { district: '', rest: address };
}
---
<section class="tenant-properties" aria-labelledby="tenant-properties-title">
  <div class="wrap">
    <div class="section-head row">
      <div>
        <p class="eyebrow">— {intro.eyebrow}</p>
        <h2 id="tenant-properties-title">{intro.title}</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <p class="section-lede">{intro.lede}</p>
    </div>

    <div class="props is-static" id="props-list" aria-label="出租物件一覽">
      {sortedItems.length === 0 ? (
        <p class="props-empty" role="status">目前無可入住物件。</p>
      ) : (
        sortedItems.map((item, index) => {
          const { district, rest } = splitAddress(item.address);
          return (
            <div class="prop-row" data-page={Math.floor(index / PAGE_SIZE) + 1}>
              <span class="idx">No.{String(index + 1).padStart(2, '0')}</span>
              <span class="name">{item.property_public_name}</span>
              <span class="addr"><span class="district">{district}</span>{rest}</span>
              <span class:list={['prop-chip', { full: !item.has_vacant_room }]}>
                <span class="pip" aria-hidden="true"></span>
                {item.has_vacant_room ? '可入住' : '滿房'}
              </span>
              <span aria-hidden="true"></span>
            </div>
          );
        })
      )}
    </div>

    <div class="props-foot" id="props-foot" style={sortedItems.length === 0 ? 'visibility:hidden' : undefined}>
      <span class="count" id="props-count">
        共 <em>{vacantCount}</em> 間可入住 · <span id="range-copy">共 {sortedItems.length} 間</span>
      </span>
      <div class="pager" id="pager" hidden>
        <button type="button" id="prev-page" aria-label="上一頁">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 5l-7 7 7 7"></path></svg>
        </button>
        <span class="pos"><em id="page-now">1</em> / <span id="page-total">{totalPages}</span></span>
        <button type="button" id="next-page" aria-label="下一頁">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
.tenant-properties {
  padding: var(--section-y-lg) 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  flex-wrap: wrap;
  margin-bottom: 48px;
}

.eyebrow {
  margin: 0 0 16px;
  color: var(--color-brand-strong);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.section-head h2 {
  max-width: 18ch;
  margin: 0;
  color: var(--color-heading);
  font-size: clamp(32px, 4vw, var(--text-4xl));
  font-weight: 600;
  line-height: 1.12;
}

.section-rule {
  display: block;
  width: 72px;
  height: 3px;
  margin-top: 24px;
  background: var(--color-brand);
}

.section-lede {
  max-width: 420px;
  margin: 0;
  color: var(--color-text);
  font-size: var(--text-sm);
  line-height: 1.8;
}

.props {
  border-top: 1px solid var(--color-hairline);
}

.prop-row {
  display: grid;
  grid-template-columns: 64px max-content minmax(160px, max-content) 110px 1fr;
  align-items: center;
  column-gap: 36px;
  padding: 22px 0;
  border-bottom: 1px solid var(--color-hairline);
}

.idx {
  color: var(--color-text-muted);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.name {
  color: var(--color-heading);
  font-size: var(--text-2xl);
  font-weight: 600;
  line-height: 1.15;
  white-space: nowrap;
}

.addr {
  color: var(--color-text);
  font-size: 14.5px;
}

.district {
  margin-right: 6px;
  color: var(--color-text-muted);
}

.prop-chip {
  justify-self: start;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px 6px 10px;
  color: var(--color-heading);
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  border: 1px solid var(--color-hairline);
  border-radius: 999px;
  background: var(--color-white);
  white-space: nowrap;
}

.pip {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--color-brand-strong);
  box-shadow: 0 0 0 3px rgba(217, 156, 9, .15);
}

.prop-chip.full {
  color: var(--color-text-soft);
  background: transparent;
}

.prop-chip.full .pip {
  background: var(--color-text-muted);
  box-shadow: none;
}

.props-empty {
  margin: 0;
  padding: 64px 0;
  color: var(--color-text-soft);
  text-align: center;
  border-bottom: 1px solid var(--color-hairline);
}

.props-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 24px;
  color: var(--color-text-soft);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.04em;
}

.props-foot em {
  color: var(--color-brand-strong);
  font-style: normal;
  font-weight: 500;
}

.pager {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.pager button {
  display: inline-flex;
  width: 32px;
  height: 32px;
  align-items: center;
  justify-content: center;
  color: var(--color-heading);
  border: 1px solid var(--color-hairline);
  border-radius: 50%;
  background: var(--color-white);
  transition: background .15s ease, border-color .15s ease, color .15s ease, opacity .15s ease;
}

.pager button:hover:not(:disabled) {
  color: var(--color-white);
  border-color: var(--color-heading);
  background: var(--color-heading);
}

.pager button:disabled {
  cursor: not-allowed;
  opacity: .35;
}

.pos {
  margin: 0 10px;
  color: var(--color-heading);
}

@media (max-width: 820px) {
  .tenant-properties {
    padding: var(--section-y-mobile) 0;
  }

  .section-head {
    margin-bottom: 36px;
  }

  .prop-row {
    grid-template-columns: 52px minmax(0, 1fr) 96px;
    grid-template-areas:
      "idx name chip"
      "idx addr chip";
    row-gap: 6px;
    column-gap: 16px;
    padding: 20px 0;
  }

  .idx {
    grid-area: idx;
    align-self: start;
    padding-top: 6px;
  }

  .name {
    grid-area: name;
    font-size: var(--text-xl);
    white-space: normal;
  }

  .addr {
    grid-area: addr;
    font-size: 13.5px;
  }

  .prop-chip {
    grid-area: chip;
    justify-self: end;
  }
}
</style>

<script>
const PAGE_SIZE = 8;
let currentPage = 1;

function drawPropsPage() {
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#props-list .prop-row'));
  if (rows.length === 0) return;

  const totalPages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
  const start = (currentPage - 1) * PAGE_SIZE;
  const end = Math.min(start + PAGE_SIZE, rows.length);

  rows.forEach((row, index) => {
    row.style.display = index >= start && index < end ? 'grid' : 'none';
  });

  const pager = document.getElementById('pager');
  const pageNow = document.getElementById('page-now');
  const pageTotal = document.getElementById('page-total');
  const prevPage = document.getElementById('prev-page') as HTMLButtonElement | null;
  const nextPage = document.getElementById('next-page') as HTMLButtonElement | null;
  const rangeCopy = document.getElementById('range-copy');

  if (!pager || !pageNow || !pageTotal || !prevPage || !nextPage || !rangeCopy) return;

  rangeCopy.textContent = `顯示 ${start + 1}-${end} / ${rows.length} 間`;

  if (totalPages > 1) {
    pager.hidden = false;
    pageNow.textContent = String(currentPage);
    pageTotal.textContent = String(totalPages);
    prevPage.disabled = currentPage <= 1;
    nextPage.disabled = currentPage >= totalPages;
  } else {
    pager.hidden = true;
  }
}

document.getElementById('prev-page')?.addEventListener('click', () => {
  if (currentPage > 1) {
    currentPage -= 1;
    drawPropsPage();
    document.getElementById('props-list')?.scrollIntoView({ behavior: 'instant', block: 'start' });
  }
});

document.getElementById('next-page')?.addEventListener('click', () => {
  const totalPages = Math.ceil(document.querySelectorAll('#props-list .prop-row').length / PAGE_SIZE);
  if (currentPage < totalPages) {
    currentPage += 1;
    drawPropsPage();
    document.getElementById('props-list')?.scrollIntoView({ behavior: 'instant', block: 'start' });
  }
});

drawPropsPage();
</script>
