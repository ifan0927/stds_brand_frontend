---
import type { PropertyAvailabilityItem } from '../lib/api/brand';

type Props = {
  items: PropertyAvailabilityItem[];
};

const PAGE_SIZE = 6;
const { items } = Astro.props;
const sortedItems = [...items].sort((a, b) => Number(b.has_vacant_room) - Number(a.has_vacant_room));
const totalPages = Math.max(1, Math.ceil(sortedItems.length / PAGE_SIZE));
const vacantCount = sortedItems.filter((item) => item.has_vacant_room).length;
const firstPageCount = Math.min(PAGE_SIZE, sortedItems.length);

function splitAddress(address: string): { district: string; rest: string } {
  const match = address.match(/^(.+?[市縣].+?[區鄉鎮市])(.*)$/);
  if (match) return { district: match[1], rest: match[2].trim() };
  return { district: '', rest: address };
}
---
<section class="band" id="properties">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="label">— 目前可入住</div>
        <h2>正在<em>等你的</em><br>下一個家。</h2>
      </div>
      <p class="right">每一間物件皆由奕德親自驗收、簽約、代管，分布於大台南各行政區。</p>
    </div>

    <div class="props-list" id="props-list" aria-label="可入住物件列表">
      {sortedItems.length === 0 ? (
        <p role="status" style="color:var(--muted);text-align:center;padding:64px 0;border-bottom:1px solid var(--hairline);">目前無可入住物件。</p>
      ) : (
        sortedItems.map((item, index) => {
          const { district, rest } = splitAddress(item.address);
          return (
            <div class="prop-row" data-id={item.property_id} data-page={Math.floor(index / PAGE_SIZE) + 1} style={index >= PAGE_SIZE ? 'display:none' : undefined}>
              <span class="idx">{String(index + 1).padStart(2, '0')}</span>
              <span class="name">{item.property_public_name}</span>
              <span class="addr"><span class="district">{district}</span>{rest}</span>
              <span class:list={['prop-chip', { full: !item.has_vacant_room }]}>
                <span class="pip"></span>
                {item.has_vacant_room ? '可入住' : '滿房'}
              </span>
              <span class="arrow">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </div>
          );
        })
      )}
    </div>
    <div class="props-foot" id="props-foot" style={sortedItems.length === 0 ? 'visibility:hidden' : undefined}>
      <span class="count">
        共 <em id="vacant-count">{vacantCount}</em> 間可入住 · 顯示 <span id="shown-range">1–{firstPageCount}</span> / <span id="props-total">{sortedItems.length}</span> 間
      </span>
      <div class="pager" id="pager" hidden={totalPages <= 1}>
        <button type="button" id="prev-page" aria-label="上一頁">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 5l-7 7 7 7"/></svg>
        </button>
        <span class="pos"><em id="page-now">1</em> / <span id="page-total">{totalPages}</span></span>
        <button type="button" id="next-page" aria-label="下一頁">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style is:global>
/* ---------- properties (editorial registry) ---------- */
.props-list{
  border-top: 1px solid var(--hairline);
}
.prop-row{
  display: grid;
  grid-template-columns: 56px 1fr 1.1fr 110px 28px;
  align-items: center;
  gap: 24px;
  padding: 22px 12px 22px 4px;
  border-bottom: 1px solid var(--hairline);
  cursor: pointer;
  transition: background .18s ease, padding .18s ease;
}
.prop-row:hover{ background: var(--surface-soft); padding-left: 16px; }
.prop-row .idx{
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 1px;
}
.prop-row .name{
  font-family: var(--serif);
  font-size: 28px;
  line-height: 1.1;
  letter-spacing: -.3px;
  color: var(--ink);
}
.prop-row .addr{
  font-size: 14.5px;
  color: var(--body);
}
.prop-row .addr .district{
  color: var(--muted);
  margin-right: 6px;
}
.prop-chip{
  justify-self: start;
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 12px 6px 10px;
  border-radius: var(--r-pill);
  background: var(--canvas);
  border: 1px solid var(--hairline);
  font-size: 12.5px; font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
}
.prop-chip .pip{
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--leaf);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--leaf) 18%, transparent);
}
.prop-chip.full{ color: var(--muted); background: transparent; }
.prop-chip.full .pip{ background: var(--muted-soft); box-shadow: none; }
.prop-row .arrow{
  width: 28px; height: 28px;
  border-radius: 50%;
  border: 1px solid var(--hairline);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--muted);
  transition: transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
}
.prop-row:hover .arrow{
  background: var(--ink); color: var(--canvas); border-color: var(--ink);
  transform: translateX(2px);
}
.props-foot{
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 24px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 0.6px;
  gap: 16px;
  flex-wrap: wrap;
}
.props-foot .count em{
  font-style: normal;
  color: var(--accent-deep);
  font-weight: 500;
}
.pager{
  display: inline-flex; align-items: center; gap: 6px;
}
.pager button{
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 1px solid var(--hairline);
  background: var(--canvas);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--ink);
  transition: background .15s ease, border-color .15s ease, color .15s ease, opacity .15s ease;
}
.pager button:hover:not(:disabled){ background: var(--ink); color: var(--canvas); border-color: var(--ink); }
.pager button:disabled{ opacity: .35; cursor: not-allowed; }
.pager .pos{
  margin: 0 10px;
  font-family: var(--mono);
  font-size: 12.5px;
  color: var(--ink);
  letter-spacing: 0.6px;
}
.pager .pos em{
  font-style: normal;
  color: var(--accent-deep);
  font-weight: 500;
}
@media (max-width: 820px){
  .prop-row{
    grid-template-columns: 40px 1fr 96px;
    grid-template-areas:
      "idx  name  chip"
      "idx  addr  arrow";
    row-gap: 6px;
    padding: 20px 8px;
  }
  .prop-row .idx{ grid-area: idx; align-self: start; padding-top: 6px; }
  .prop-row .name{ grid-area: name; font-size: 22px; }
  .prop-row .addr{ grid-area: addr; font-size: 13.5px; }
  .prop-chip{ grid-area: chip; justify-self: end; }
  .prop-row .arrow{ grid-area: arrow; justify-self: end; }
}
/* skeleton row */
.prop-row-skel{
  height: 76px;
  border-bottom: 1px solid var(--hairline);
  background: linear-gradient(90deg,
    transparent 0%,
    color-mix(in oklab, var(--surface-soft) 60%, transparent) 50%,
    transparent 100%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
</style>

<script>
const PAGE_SIZE = 6;
let _propsPage = 1;

function drawPropsPage(){
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#props-list .prop-row'));
  if (rows.length === 0) return;

  const totalPages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
  const start = (_propsPage - 1) * PAGE_SIZE;
  const end = Math.min(start + PAGE_SIZE, rows.length);

  rows.forEach((row, index) => {
    row.style.display = index >= start && index < end ? 'grid' : 'none';
  });

  const pager = document.getElementById('pager');
  const pageNow = document.getElementById('page-now');
  const pageTotal = document.getElementById('page-total');
  const prevPage = document.getElementById('prev-page') as HTMLButtonElement | null;
  const nextPage = document.getElementById('next-page') as HTMLButtonElement | null;
  const shownRange = document.getElementById('shown-range');

  if (!pager || !pageNow || !pageTotal || !prevPage || !nextPage || !shownRange) return;

  shownRange.textContent = `${start + 1}–${end}`;

  if (totalPages > 1){
    pager.hidden = false;
    pageNow.textContent = String(_propsPage);
    pageTotal.textContent = String(totalPages);
    prevPage.disabled = _propsPage <= 1;
    nextPage.disabled = _propsPage >= totalPages;
  } else {
    pager.hidden = true;
  }
}

document.getElementById('prev-page')?.addEventListener('click', () => {
  if (_propsPage > 1){
    _propsPage -= 1;
    drawPropsPage();
    document.getElementById('properties').scrollIntoView({ behavior: 'instant', block: 'start' });
  }
});
document.getElementById('next-page')?.addEventListener('click', () => {
  const total = Math.ceil(document.querySelectorAll('#props-list .prop-row').length / PAGE_SIZE);
  if (_propsPage < total){
    _propsPage += 1;
    drawPropsPage();
    document.getElementById('properties').scrollIntoView({ behavior: 'instant', block: 'start' });
  }
});

drawPropsPage();
</script>
