<style is:global>
/* ---------- footer ---------- */
footer.foot{
  padding: 56px 0 32px;
}
.foot-inner{
  display: flex; justify-content: space-between; align-items: center;
  gap: 24px;
  flex-wrap: wrap;
  padding-top: 32px;
  border-top: 1px solid var(--hairline-soft);
}
.foot-meta{
  display: flex; gap: 18px; align-items: center;
  font-size: 12.5px; color: var(--muted);
  flex-wrap: wrap;
}
.foot-meta .sep{ width: 1px; height: 12px; background: var(--hairline); }
</style>
