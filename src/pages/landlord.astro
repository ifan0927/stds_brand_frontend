---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildPageMetadata } from '../lib/seo/site';
import { getLinkAttributes } from '../lib/site/chrome';
import landlordPage from '../../content/pages/landlord/page.json';
import siteSettings from '../../content/site-settings/site.json';

const metadata = buildPageMetadata({
  title: landlordPage.seoTitle,
  description: landlordPage.seoDescription,
  path: '/landlord',
  siteName: siteSettings.brandName,
  ogImagePath: landlordPage.photo,
});
const landlordLink = getLinkAttributes(siteSettings.forms.landlordUrl);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: landlordPage.seoTitle,
  description: landlordPage.seoDescription,
  url: metadata.canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: siteSettings.brandName,
    url: new URL('/', metadata.canonicalUrl).toString(),
  },
};
---
<BaseLayout metadata={metadata} structuredData={structuredData} headerCtaVariant="landlord" footerMetaLabel="For Landlords">
  <main class="landlord-page">
    <section class="page-head" aria-labelledby="page-title">
      <div class="wrap">
        <nav class="crumbs" aria-label="麵包屑">
          <a href="/">首頁</a>
          <span class="sep" aria-hidden="true"></span>
          <span aria-current="page">我是房東</span>
        </nav>
        <p class="eyebrow">— {landlordPage.head.eyebrow}</p>
        <h1 id="page-title">{landlordPage.head.title}</h1>
        <span class="page-rule" aria-hidden="true"></span>
        <p class="page-lede">{landlordPage.head.lede}</p>
      </div>
    </section>

    <section class="landlord-service" aria-labelledby="landlord-service-title">
      <div class="wrap">
        <h2 id="landlord-service-title" class="sr-only">房東服務價值</h2>
        <div class="for-grid">
          <div class="service-list">
            {landlordPage.services.map((item, index) => (
              <article class="service-item">
                <span class="num">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </article>
            ))}
          </div>

          <figure class="for-photo">
            <img src={landlordPage.photo} alt="整理乾淨的出租空間" width="720" height="900" loading="lazy" />
          </figure>
        </div>

        <div class="lead-cta">
          <div>
            <p class="eyebrow">{landlordPage.cta.eyebrow}</p>
            <h2 id="landlord-cta-title">{landlordPage.cta.title}</h2>
            <p>{landlordPage.cta.body}</p>
          </div>
          <a class="btn-primary" {...landlordLink}>
            {landlordPage.cta.ctaLabel}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.landlord-page {
  background: var(--color-page);
}

.page-head {
  padding: 74px 0 58px;
  background: var(--color-white);
  border-bottom: 1px solid var(--color-hairline);
}

.crumbs {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 34px;
  color: var(--color-text-soft);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.06em;
}

.crumbs a {
  color: var(--color-text);
  transition: color .2s ease;
}

.crumbs a:hover {
  color: var(--color-brand-strong);
}

.crumbs .sep {
  width: 22px;
  height: 1px;
  background: var(--color-muted-border);
}

.eyebrow {
  margin: 0 0 18px;
  color: var(--color-brand-strong);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.page-head h1 {
  max-width: 12ch;
  margin: 0;
  color: var(--color-heading);
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 600;
  line-height: 1.18;
}

.page-rule {
  display: block;
  width: 84px;
  height: 3px;
  margin: 28px 0;
  background: var(--color-brand);
}

.page-lede {
  max-width: var(--container-narrow);
  margin: 0;
  color: var(--color-text);
  font-size: var(--text-lg);
  line-height: 1.9;
}

.landlord-service {
  padding: var(--section-y-lg) 0;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.for-grid {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  align-items: start;
  gap: 64px;
}

.service-list {
  display: grid;
  gap: 0;
  border-top: 1px solid var(--color-muted-border);
}

.service-item {
  display: grid;
  grid-template-columns: 64px minmax(0, 1fr);
  gap: 28px;
  padding: 28px 0;
  border-bottom: 1px solid var(--color-muted-border);
}

.num {
  color: var(--color-brand-strong);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: 500;
}

.service-item h3 {
  margin: 0;
  color: var(--color-heading);
  font-size: var(--text-xl);
  font-weight: 600;
  line-height: 1.35;
}

.service-item p {
  margin: 12px 0 0;
  color: var(--color-text);
  line-height: 1.85;
}

.for-photo {
  position: relative;
  overflow: hidden;
  margin: 0;
  aspect-ratio: 4 / 5;
  background: var(--color-soft-surface);
}

.for-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lead-cta {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 32px;
  margin-top: 64px;
  padding: 44px 48px;
  background: var(--color-white);
  border: 1px solid var(--color-muted-border);
  border-top: 3px solid var(--color-brand);
}

.lead-cta h2 {
  margin: 0;
  color: var(--color-heading);
  font-size: clamp(24px, 3vw, 32px);
  font-weight: 600;
  line-height: 1.3;
}

.lead-cta p:last-child {
  max-width: 46ch;
  margin: 14px 0 0;
  color: var(--color-text-soft);
  font-size: 15.5px;
  line-height: 1.8;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 44px;
  padding: 16px 30px;
  color: var(--color-white);
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.06em;
  background: var(--color-brand);
  transition: background .2s ease;
  white-space: nowrap;
}

.btn-primary:hover {
  background: var(--color-brand-strong);
}

@media (max-width: 880px) {
  .for-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .for-photo {
    order: -1;
    aspect-ratio: 16 / 10;
  }
}

@media (max-width: 720px) {
  .page-head {
    padding: 48px 0;
  }

  .page-lede {
    font-size: var(--text-base);
  }

  .landlord-service {
    padding: var(--section-y-mobile) 0;
  }

  .service-item {
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 18px;
    padding: 24px 0;
  }

  .lead-cta {
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 32px 24px;
  }

  .btn-primary {
    width: 100%;
    white-space: normal;
  }
}
</style>
