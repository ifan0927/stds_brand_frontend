---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildPageMetadata } from '../lib/seo/site';
import homePage from '../../content/pages/home/page.json';
import siteSettings from '../../content/site-settings/site.json';

const metadata = buildPageMetadata({
  title: homePage.seoTitle,
  description: homePage.seoDescription,
  path: '/',
  siteName: siteSettings.brandName,
  ogImagePath: homePage.hero.image,
});
---
<BaseLayout metadata={metadata}>
  <main class="foundation-page">
    <section class="foundation-hero" aria-labelledby="page-title">
      <div class="wrap foundation-grid">
        <div class="foundation-copy">
          <p class="eyebrow">{homePage.hero.eyebrow}</p>
          <h1 id="page-title">{homePage.hero.title}</h1>
          <p class="lede">{homePage.hero.subtitle}</p>
        </div>
        <figure class="foundation-media">
          <img src={homePage.hero.image} alt="奕德不動產服務形象照" width="1200" height="760" />
        </figure>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.foundation-page {
  min-height: 100vh;
  background: var(--color-page);
}

.foundation-hero {
  padding: 84px 0;
}

.foundation-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.94fr) minmax(320px, 1.06fr);
  gap: 52px;
  align-items: center;
}

.foundation-copy {
  max-width: 620px;
}

.eyebrow {
  margin: 0 0 20px;
  color: var(--color-brand-strong);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  color: var(--color-heading);
  font-size: clamp(40px, 6vw, var(--text-4xl));
  font-weight: 600;
  line-height: 1.12;
  letter-spacing: 0;
}

.lede {
  max-width: 34rem;
  margin: 28px 0 0;
  color: var(--color-text);
  font-size: var(--text-lg);
  line-height: 1.75;
}

.foundation-media {
  margin: 0;
  border: 1px solid var(--color-hairline);
  background: var(--color-soft-surface);
}

.foundation-media img {
  width: 100%;
  aspect-ratio: 12 / 7.6;
  object-fit: cover;
}

@media (max-width: 860px) {
  .foundation-hero {
    padding: 56px 0;
  }

  .foundation-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .foundation-media {
    order: -1;
  }
}
</style>
