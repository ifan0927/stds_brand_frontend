---
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import PropertiesRegistry from '../components/PropertiesRegistry.astro';
import AboutSection from '../components/AboutSection.astro';
import FaqList from '../components/FaqList.astro';
import ContactBand from '../components/ContactBand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { fetchPublicBrandHomeData } from '../lib/api/brand';

const { profile, faqs, availability } = await fetchPublicBrandHomeData();
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>奕德不動產 — 大台南包租代管</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Noto+Sans+TC:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
</head>
<body>

<SiteHeader />
<Hero />
<PropertiesRegistry items={availability} />
<AboutSection />
<FaqList items={faqs} />
<ContactBand profile={profile} />
<SiteFooter updatedAt={profile?.updated_at ?? null} />

<style is:global>
@import "../styles/base.css";
</style>

</body>
</html>
