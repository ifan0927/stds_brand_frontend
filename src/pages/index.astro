---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildPageMetadata } from '../lib/seo/site';
import { getContactRows, getLinkAttributes } from '../lib/site/chrome';
import homePage from '../../content/pages/home/page.json';
import siteSettings from '../../content/site-settings/site.json';

type FaqItem = {
  question: string;
  answer: string;
  sort_order: number;
};

const faqModules = import.meta.glob('../../content/faqs/*.json', {
  eager: true,
  import: 'default',
});
const faqs = Object.values(faqModules)
  .map((item) => item as FaqItem)
  .sort((a, b) => a.sort_order - b.sort_order);

const metadata = buildPageMetadata({
  title: homePage.seoTitle,
  description: homePage.seoDescription,
  path: '/',
  siteName: siteSettings.brandName,
  ogImagePath: homePage.hero.image,
});

const contactRows = getContactRows(siteSettings);
const phoneHref = `tel:${siteSettings.contact.phone.replace(/[^\d+]/g, '')}`;
const mailHref = `mailto:${siteSettings.contact.email}`;
const dualEntryLinks = ['/tenant', '/landlord'];
const sameAs = [siteSettings.social.lineUrl, siteSettings.social.fbUrl].filter((href) =>
  /^https?:\/\//.test(href),
);

function absoluteUrl(pathOrUrl: string): string {
  return new URL(pathOrUrl, metadata.canonicalUrl).toString();
}

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteSettings.brandName,
    alternateName: siteSettings.brandNameEn,
    url: metadata.canonicalUrl,
    logo: absoluteUrl(siteSettings.logo),
    telephone: siteSettings.contact.phone,
    email: siteSettings.contact.email,
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteSettings.brandName,
    url: metadata.canonicalUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---
<BaseLayout metadata={metadata} structuredData={structuredData}>
  <main class="home-page">
    <section class="home-hero" id="top" aria-labelledby="page-title">
      <img class="home-hero-image" src={homePage.hero.image} alt="奕德不動產在地服務代表物件室內實景" width="1600" height="980" />
      <div class="home-hero-scrim" aria-hidden="true"></div>
      <div class="wrap home-hero-inner">
        <p class="eyebrow">{homePage.hero.eyebrow}</p>
        <h1 id="page-title">{homePage.hero.title}</h1>
        <span class="gold-rule" aria-hidden="true"></span>
        <p class="hero-subtitle">{homePage.hero.subtitle}</p>
      </div>
    </section>

    <section class="dual-entry" aria-label="服務入口">
      <div class="wrap dual-grid">
        {homePage.dualEntry.map((entry, index) => (
          <a class:list={['dual-card', { inverted: index === 1 }]} href={dualEntryLinks[index] ?? '/'}>
            <span class="tag">{entry.tag}</span>
            <h2>{entry.title}</h2>
            <p>{entry.body}</p>
            <span class="go">
              {entry.ctaLabel}
              <span class="go-icon" aria-hidden="true">-></span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="about-band" id="about" aria-labelledby="about-title">
      <div class="wrap">
        <div class="section-head row">
          <div>
            <p class="eyebrow">{homePage.about.eyebrow}</p>
            <h2 id="about-title">{homePage.about.title}</h2>
            <span class="section-rule" aria-hidden="true"></span>
          </div>
          <p class="section-lede">{homePage.about.lede}</p>
        </div>

        <div class="about-grid">
          <figure class="about-photo">
            <img src={homePage.about.photo} alt={`${homePage.about.ownerRole} ${homePage.about.ownerName}`} width="720" height="900" loading="lazy" />
            <figcaption>
              <span>{homePage.about.ownerRole}</span>
              <strong>{homePage.about.ownerName}</strong>
            </figcaption>
          </figure>

          <div class="service-list">
            {homePage.about.services.map((item, index) => (
              <article class="service-item">
                <span class="num">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <blockquote class="quote-block">
          <p>{homePage.about.quote}</p>
          <footer>{homePage.about.quoteMeta}</footer>
        </blockquote>
      </div>
    </section>

    <section class="interior-band" aria-label="室內意象">
      <div class="wrap interior-grid">
        {homePage.interior.map((item) => (
          <figure class="interior-card">
            <img src={item.image} alt={item.caption} width="720" height="520" loading="lazy" />
            <figcaption>
              <span>{item.kicker}</span>
              <strong>{item.caption}</strong>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="image-band" aria-labelledby="cta-band-title">
      <img src={homePage.ctaBand.image} alt="" width="1600" height="720" loading="lazy" />
      <div class="image-band-scrim" aria-hidden="true"></div>
      <div class="wrap image-band-inner">
        <p class="eyebrow">{homePage.ctaBand.eyebrow}</p>
        <h2 id="cta-band-title">{homePage.ctaBand.title}</h2>
        <p>{homePage.ctaBand.subtitle}</p>
        <div class="cta-row">
          {homePage.ctaBand.buttons.map((button, index) => (
            <a class:list={['btn', index === 0 ? 'primary' : 'light']} href={button.href}>{button.label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="credentials-section" id="trust" aria-labelledby="credentials-title">
      <div class="wrap">
        <div class="section-head row">
          <div>
            <p class="eyebrow">{homePage.credentials.eyebrow}</p>
            <h2 id="credentials-title">{homePage.credentials.title}</h2>
            <span class="section-rule" aria-hidden="true"></span>
          </div>
          <p class="section-lede">{homePage.credentials.lede}</p>
        </div>

        <div class="credentials-grid">
          {homePage.credentials.items.map((item) => (
            <figure class="credential-card">
              <img src={item.image} alt={item.title} width="640" height="420" loading="lazy" />
              <figcaption>
                <span>{item.kicker}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="section-head row">
          <div>
            <p class="eyebrow">{homePage.faqIntro.eyebrow}</p>
            <h2 id="faq-title">{homePage.faqIntro.title}</h2>
            <span class="section-rule" aria-hidden="true"></span>
          </div>
          <p class="section-lede">{homePage.faqIntro.lede}</p>
        </div>

        <div class="faq-list" aria-label="常見問題列表">
          {faqs.map((item, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>
                <span class="q-num">Q.{String(index + 1).padStart(2, '0')}</span>
                <span class="q-text">{item.question}</span>
                <span class="q-plus" aria-hidden="true">+</span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-band" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">{homePage.contact.eyebrow}</p>
            <h2 id="contact-title">{homePage.contact.title}</h2>
            <span class="section-rule" aria-hidden="true"></span>
          </div>
        </div>

        <div class="contact-grid">
          <div class="contact-copy">
            <p>{homePage.contact.lede}</p>
            <div class="cta-row">
              <a class="btn primary" href={phoneHref}>立即撥打</a>
              <a class="btn outline" href={mailHref}>來信詢問</a>
            </div>
          </div>

          <div class="contact-info" aria-label="聯絡資訊">
            {contactRows.map((row) => (
              <div class="contact-row">
                <span class="contact-key">{row.key}</span>
                {row.href ? (
                  <a class="contact-value" {...getLinkAttributes(row.href, row.external)}>{row.label}</a>
                ) : (
                  <span class="contact-value">{row.label}</span>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.home-page {
  background: var(--color-page);
}

.home-hero {
  position: relative;
  min-height: min(760px, calc(100vh - 88px));
  display: grid;
  align-items: end;
  overflow: hidden;
  color: var(--color-white);
}

.home-hero-image,
.home-hero-scrim {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-hero-image {
  object-fit: cover;
}

.home-hero-scrim {
  background: linear-gradient(90deg, rgba(24, 22, 21, .74), rgba(24, 22, 21, .46) 46%, rgba(24, 22, 21, .2));
}

.home-hero-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  padding-top: 120px;
  padding-bottom: 108px;
}

.eyebrow {
  margin: 0 0 18px;
  color: var(--color-brand-strong);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.home-hero .eyebrow,
.image-band .eyebrow {
  color: var(--color-brand);
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  max-width: 12ch;
  margin-bottom: 26px;
  color: var(--color-white);
  font-size: clamp(40px, 6vw, 64px);
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: 0;
}

.gold-rule,
.section-rule {
  display: block;
  width: 72px;
  height: 3px;
  background: var(--color-brand);
}

.hero-subtitle {
  max-width: 560px;
  margin: 28px 0 0;
  color: rgba(255, 255, 255, .86);
  font-size: var(--text-lg);
  line-height: 1.8;
}

.dual-entry,
.about-band,
.interior-band,
.credentials-section,
.faq-section,
.contact-band {
  padding: var(--section-y-lg) 0;
}

.dual-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
}

.dual-card {
  display: flex;
  min-height: 280px;
  flex-direction: column;
  justify-content: space-between;
  padding: 34px;
  background: var(--color-white);
  border: 1px solid var(--color-muted-border);
  transition: border-color .2s ease, transform .2s ease;
}

.dual-card:hover {
  border-color: var(--color-brand);
  transform: translateY(-2px);
}

.dual-card.inverted {
  background: var(--color-footer);
  border-color: var(--color-footer);
  color: var(--color-white);
}

.tag,
.num,
.q-num,
.contact-key,
.credential-card span,
.interior-card span {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.tag {
  color: var(--color-text-soft);
}

.dual-card.inverted .tag {
  color: rgba(255, 255, 255, .68);
}

.dual-card h2 {
  margin: 26px 0 16px;
  color: inherit;
  font-size: clamp(26px, 3vw, 36px);
  font-weight: 600;
  line-height: 1.25;
}

.dual-card p {
  color: var(--color-text);
  line-height: 1.75;
}

.dual-card.inverted p {
  color: rgba(255, 255, 255, .76);
}

.go {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 20px;
  color: inherit;
  font-weight: 600;
}

.go-icon {
  color: var(--color-brand-strong);
}

.section-head {
  margin-bottom: 50px;
}

.section-head.row {
  display: grid;
  grid-template-columns: minmax(0, .95fr) minmax(280px, .55fr);
  align-items: end;
  gap: 64px;
}

.section-head h2,
.image-band h2,
.contact-band h2 {
  max-width: 14ch;
  margin: 0 0 20px;
  color: var(--color-heading);
  font-size: clamp(32px, 4.2vw, var(--text-4xl));
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: 0;
}

.section-lede {
  margin: 0;
  color: var(--color-text);
  line-height: 1.85;
}

.about-grid {
  display: grid;
  grid-template-columns: minmax(280px, .76fr) minmax(0, 1fr);
  gap: 56px;
  align-items: start;
}

.about-photo,
.interior-card,
.credential-card {
  margin: 0;
}

.about-photo {
  position: relative;
  border: 1px solid var(--color-muted-border);
  background: var(--color-soft-surface);
}

.about-photo img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.about-photo figcaption {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  padding: 16px 18px;
  background: var(--color-white);
  border-top: 1px solid var(--color-muted-border);
}

.about-photo span {
  color: var(--color-text-soft);
}

.about-photo strong {
  color: var(--color-heading);
  font-weight: 600;
}

.service-list {
  display: grid;
  gap: 0;
  border-top: 1px solid var(--color-hairline);
}

.service-item {
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr);
  gap: 28px;
  padding: 28px 0;
  border-bottom: 1px solid var(--color-hairline);
}

.num {
  color: var(--color-brand-strong);
}

.service-item h3 {
  margin-bottom: 8px;
  color: var(--color-heading);
  font-size: var(--text-xl);
  font-weight: 600;
  line-height: 1.35;
}

.service-item p {
  margin-bottom: 0;
  color: var(--color-text);
  line-height: 1.75;
}

.quote-block {
  margin: 54px 0 0;
  padding: 32px 0 0;
  border-top: 1px solid var(--color-muted-border);
}

.quote-block p {
  max-width: 780px;
  margin-bottom: 14px;
  color: var(--color-heading);
  font-size: clamp(24px, 3vw, 34px);
  font-weight: 500;
  line-height: 1.5;
}

.quote-block footer {
  color: var(--color-text-soft);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: .08em;
  text-transform: uppercase;
}

.interior-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.interior-card img,
.credential-card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border: 1px solid var(--color-muted-border);
}

.interior-card figcaption {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  padding-top: 14px;
  color: var(--color-heading);
}

.interior-card span,
.credential-card span {
  color: var(--color-brand-strong);
}

.interior-card strong {
  font-weight: 500;
  text-align: right;
}

.image-band {
  position: relative;
  min-height: 470px;
  display: grid;
  align-items: center;
  overflow: hidden;
  color: var(--color-white);
}

.image-band > img,
.image-band-scrim {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.image-band > img {
  object-fit: cover;
}

.image-band-scrim {
  background: rgba(24, 22, 21, .62);
}

.image-band-inner {
  position: relative;
  z-index: 1;
  padding-top: 80px;
  padding-bottom: 80px;
}

.image-band h2 {
  color: var(--color-white);
}

.image-band p:not(.eyebrow) {
  max-width: 560px;
  color: rgba(255, 255, 255, .82);
  line-height: 1.8;
}

.cta-row {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.btn {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  border: 1px solid transparent;
  color: var(--color-heading);
  font-weight: 600;
  letter-spacing: .04em;
  transition: background .2s ease, border-color .2s ease, color .2s ease;
}

.btn.primary {
  background: var(--color-brand);
  color: var(--color-white);
}

.btn.primary:hover {
  background: var(--color-brand-strong);
}

.btn.light {
  color: var(--color-white);
  border-color: rgba(255, 255, 255, .52);
}

.btn.light:hover {
  background: var(--color-white);
  color: var(--color-heading);
}

.btn.outline {
  color: var(--color-white);
  border-color: rgba(255, 255, 255, .35);
}

.btn.outline:hover {
  border-color: var(--color-brand);
  color: var(--color-brand);
}

.credentials-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.credential-card {
  background: var(--color-white);
  border: 1px solid var(--color-muted-border);
}

.credential-card figcaption {
  padding: 22px;
}

.credential-card h3 {
  margin: 14px 0 10px;
  color: var(--color-heading);
  font-size: var(--text-xl);
  font-weight: 600;
}

.credential-card p {
  margin-bottom: 0;
  color: var(--color-text);
  line-height: 1.72;
}

.faq-list {
  border-top: 1px solid var(--color-hairline);
}

.faq-item {
  border-bottom: 1px solid var(--color-hairline);
}

.faq-item summary {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 26px 0;
  cursor: pointer;
  list-style: none;
}

.faq-item summary::-webkit-details-marker {
  display: none;
}

.q-num {
  min-width: 42px;
  color: var(--color-text-soft);
}

.q-text {
  flex: 1;
  color: var(--color-heading);
  font-size: var(--text-xl);
  font-weight: 600;
  line-height: 1.35;
}

.q-plus {
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-muted-border);
  color: var(--color-heading);
  transition: transform .2s ease, background .2s ease, color .2s ease;
}

.faq-item[open] .q-plus {
  background: var(--color-heading);
  color: var(--color-white);
  transform: rotate(45deg);
}

.faq-item p {
  max-width: 72ch;
  margin: 0;
  padding: 0 64px 28px 66px;
  color: var(--color-text);
  line-height: 1.8;
}

.contact-band {
  background: var(--color-footer);
  color: var(--color-white);
}

.contact-band h2 {
  color: var(--color-white);
}

.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, .82fr) minmax(320px, 1fr);
  gap: 64px;
  align-items: start;
}

.contact-copy p {
  max-width: 46ch;
  color: rgba(255, 255, 255, .76);
  font-size: var(--text-lg);
  line-height: 1.8;
}

.contact-info {
  border-top: 1px solid rgba(255, 255, 255, .14);
}

.contact-row {
  display: grid;
  grid-template-columns: 74px minmax(0, 1fr);
  gap: 18px;
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, .14);
}

.contact-key {
  color: var(--color-brand);
}

.contact-value {
  color: rgba(255, 255, 255, .86);
  line-height: 1.5;
}

a.contact-value:hover {
  color: var(--color-brand);
}

@media (max-width: 900px) {
  .home-hero {
    min-height: 620px;
  }

  .home-hero-inner {
    padding-top: 84px;
    padding-bottom: 72px;
  }

  .dual-grid,
  .section-head.row,
  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .interior-grid,
  .credentials-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .dual-entry,
  .about-band,
  .interior-band,
  .credentials-section,
  .faq-section,
  .contact-band {
    padding: var(--section-y-mobile) 0;
  }

  .dual-card {
    min-height: 240px;
    padding: 26px;
  }

  .about-photo figcaption,
  .interior-card figcaption,
  .service-item,
  .faq-item summary,
  .contact-row {
    gap: 14px;
  }

  .about-photo figcaption,
  .interior-card figcaption {
    flex-direction: column;
  }

  .interior-card strong {
    text-align: left;
  }

  .service-item {
    grid-template-columns: 42px minmax(0, 1fr);
  }

  .q-text {
    font-size: var(--text-lg);
  }

  .faq-item p {
    padding-right: 0;
    padding-left: 56px;
  }

  .contact-row {
    grid-template-columns: 1fr;
  }
}
</style>
